# Port on which the Express server will run
PORT=5001


# Environment mode (development/production)
NODE_ENV=development

# MongoDB Connection URI
MONGODB_URI=mongodb://localhost:27017/athos_collagen

# Allowed CORS Origins (comma-separated, leave blank or * to allow all)
CORS_ORIGIN=http://localhost:8080

# SMTP Configuration for sending email inquiries (e.g. Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Email Sender and Recipient Configuration (FROM_EMAIL is also used as receiver email)
FROM_NAME=Athos Collagen
FROM_EMAIL=your_email@gmail.com
